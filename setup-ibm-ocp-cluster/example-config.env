#!/usr/bin/env bash
# ============================================================================
# config.env — Single configuration file for the self-managed OCP cluster
#              on IBM Cloud VPC for Llama Stack performance evaluation
# ============================================================================
#
# Copy this file to config.env and fill in your values:
#   cp example-config.env config.env
#   vi config.env
#
# Then source it from any setup script:
#   source "$(dirname "$0")/config.env"
#
# All scripts in this directory read from here. You should never need to
# hard-code cluster-specific values in the individual scripts.
# ============================================================================

# ─── IBM CLOUD & CLUSTER ──────────────────────────────────────────────────
export IBMCLOUD_REGION="us-south"
export IBMCLOUD_ZONE="us-south-1"
export IBMCLOUD_RESOURCE_GROUP="default"             # IBM Cloud resource group
export BASE_DOMAIN="example.com"                     # Must be in IBM Cloud CIS
export CLUSTER_NAME="perf-eval"
export IC_API_KEY="${IC_API_KEY:-}"                   # IBM Cloud API key (required by openshift-install)
export PULL_SECRET_FILE="$HOME/pull-secret.json"     # Path to Red Hat pull secret
export SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_rsa.pub"   # Path to SSH public key

# ─── NODE INSTANCE TYPES (IBM Cloud VPC Gen2/Gen3 Profiles) ──────────────
export MASTER_INSTANCE_TYPE="bx2-4x16"               # 4 vCPU, 16 GB — control plane
export APP_WORKER_INSTANCE_TYPE="bx2-4x16"           # 4 vCPU, 16 GB — Llama Stack, PostgreSQL, MCP
export GPU_WORKER_INSTANCE_TYPE="gx3-24x120x1l40s"   # 24 vCPU, 120 GB, 1× L40S-48GB — vLLM inference
export LOADGEN_WORKER_INSTANCE_TYPE="cx2-8x16"       # 8 vCPU, 16 GB — load generation

# ─── STORAGE CLASS & PVC SIZES ────────────────────────────────────────────
export STORAGE_CLASS="ibmc-vpc-block-5iops-tier"     # 5 IOPS/GB VPC Block
export MODEL_STORAGE_SIZE="200Gi"
export POSTGRESQL_STORAGE_SIZE="20Gi"
export BENCHMARK_RESULTS_STORAGE_SIZE="20Gi"

# ─── NAMESPACE ────────────────────────────────────────────────────────────
export PERF_NAMESPACE="perf-testing"

# ─── HUGGING FACE ────────────────────────────────────────────────────────
export HF_TOKEN="${HF_TOKEN:-}"                      # Optional for Qwen (not gated), required for Llama models

# ─── LLM MODEL ────────────────────────────────────────────────────────────
export MODEL_ID="Qwen/Qwen2.5-7B-Instruct"                               # 7B model — BF16 on 1× L40S-48GB
# export MODEL_ID="meta-llama/Llama-3.3-70B-Instruct"                     # 70B model — requires 8× A100-80GB
export MODEL_QUANTIZED_REPO=""
export TENSOR_PARALLEL_SIZE=1                        # 1× L40S-48GB (48 GB total, ~14 GB weights → ~29 GB KV headroom)
export GPU_MEMORY_UTILIZATION="0.90"
export MAX_MODEL_LEN=16384                           # 14 GB weights + generous KV cache for high concurrency
export TOOL_CALL_PARSER="hermes"                     # hermes (Qwen) | llama3 (Llama) | openai

# ─── LLAMA STACK ──────────────────────────────────────────────────────────
export LLAMA_STACK_IMAGE="quay.io/opendatahub/llama-stack@sha256:175563c0461cc717c5918791cfcda8f5f55580e96445fa302c3dbb4d24805cdb"

# ─── INFERENCE BACKEND ─────────────────────────────────────────────────────
export VLLM_IMAGE="vllm/vllm-openai:v0.7.3"

# ─── INFERENCE SIMULATOR (llm-d) ─────────────────────────────────────────
# Set USE_SIMULATOR="true" to replace vLLM with llm-d-inference-sim.
# This removes the GPU requirement and deploys a lightweight OpenAI-compatible
# simulator on an app-worker node. Useful for testing Llama Stack, OTel,
# PostgreSQL, and monitoring without GPU instances.
# See: https://github.com/llm-d/llm-d-inference-sim
export USE_SIMULATOR="false"
export SIMULATOR_IMAGE="ghcr.io/llm-d/llm-d-inference-sim:v0.7.1"
export SIMULATOR_MODE="random"                         # random (synthetic responses) | echo (mirrors input)
export SIMULATOR_TTFT_MS="75"                          # Simulated time-to-first-token (milliseconds)
export SIMULATOR_ITL_MS="18"                           # Simulated inter-token latency (milliseconds)
export SIMULATOR_MAX_TOKENS="150"                      # Max tokens per simulated response

# ─── POSTGRESQL ──────────────────────────────────────────────────────────
export POSTGRESQL_IMAGE="postgres:16"
export POSTGRESQL_DB="llamastack"
export POSTGRESQL_USER="llamastack"
export POSTGRESQL_PASSWORD="${POSTGRESQL_PASSWORD:-changeme-$(openssl rand -hex 8 2>/dev/null || echo 'please-change-this')}"
# ^^ Auto-generates a random password on first source; subsequent sources in the same session keep it.

# ─── MCP SERVERS ──────────────────────────────────────────────────────────
export MCP_KUBERNETES_IMAGE="ghcr.io/containers/kubernetes-mcp-server:latest"
export MCP_KUBERNETES_ENABLED="true"
# Add more MCP servers as needed:
# export MCP_GITHUB_IMAGE="ghcr.io/github/github-mcp-server:latest"
# export MCP_GITHUB_ENABLED="false"

# ─── BENCHMARK RUNNER ─────────────────────────────────────────────────────
export BENCHMARK_RUNNER_IMAGE="python:3.11-slim"
export BENCHMARK_RUNNER_CPU_REQUEST="4"
export BENCHMARK_RUNNER_CPU_LIMIT="6"
export BENCHMARK_RUNNER_MEM_REQUEST="8Gi"
export BENCHMARK_RUNNER_MEM_LIMIT="12Gi"

# ─── SCALE SCHEDULE (CronJob, UTC) ───────────────────────────────────────
export SCALE_UP_SCHEDULE="0 8 * * 1-4"               # Mon-Thu 8:00 AM UTC
export SCALE_DOWN_SCHEDULE="0 18 * * 1-4"            # Mon-Thu 6:00 PM UTC

# ─── OPENTELEMETRY ────────────────────────────────────────────────────────
export OTEL_ENABLED="true"
export OTEL_OPERATOR_CHANNEL="stable"
export OTEL_COLLECTOR_IMAGE="ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.96.0"

# ─── OPERATOR CHANNELS ────────────────────────────────────────────────────
export NFD_CHANNEL="stable"
export GPU_OPERATOR_CHANNEL="stable"
export SERVERLESS_CHANNEL="stable"
export SERVICE_MESH_CHANNEL="stable"                  # Service Mesh 3 (v2 conflicts with ingress Gateway API on OCP 4.20)
export CERT_MANAGER_CHANNEL="stable-v1"
export OPENSHIFT_AI_CHANNEL="fast-3.x"                # RHOAI 3.x operator channel

# ─── OPENSHIFT INSTALLER ──────────────────────────────────────────────────
export OCP_VERSION="stable-4.20"                     # Pin to 4.20 — RHOAI 3.2 supports 4.19–4.20 only
export INSTALLER_DIR="${INSTALLER_DIR:-$(pwd)/cluster-${CLUSTER_NAME}}"

# ─── DERIVED VALUES (do not edit) ─────────────────────────────────────────
export KUBECONFIG="${INSTALLER_DIR}/auth/kubeconfig"

# ─── COLORS FOR SCRIPT OUTPUT ─────────────────────────────────────────────
export RED='\033[0;31m'
export GREEN='\033[0;32m'
export YELLOW='\033[1;33m'
export BLUE='\033[0;34m'
export NC='\033[0m' # No Color

# ─── HELPER FUNCTIONS ─────────────────────────────────────────────────────
info()  { echo -e "${BLUE}[INFO]${NC}  $*"; }
ok()    { echo -e "${GREEN}[OK]${NC}    $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*"; }
bail()  { err "$*"; exit 1; }

wait_for_resource() {
  # Usage: wait_for_resource <resource_type> <name> <namespace> <condition> <timeout>
  local resource="$1" name="$2" ns="$3" condition="$4" timeout="${5:-300s}"
  info "Waiting for $resource/$name in $ns ($condition, timeout $timeout)..."
  oc wait --for="$condition" "$resource/$name" -n "$ns" --timeout="$timeout"
}
